# Zones for the DNS bench. Every name here is under .test, which RFC 2606
# reserves for exactly this and which therefore belongs to nobody.
#
# Most of the addresses are from RFC 5737 (192.0.2.0/24, 198.51.100.0/24) and RFC
# 3849 (2001:db8::/32), reserved for documentation, so that a run against this
# bench cannot accidentally connect to anything.
#
# ONE ZONE IS A DELIBERATE EXCEPTION AND IT IS NAMED HERE RATHER THAN DISCOVERED
# LATER: partner.test points at a server on this bench's own subnet, because
# scenarios S-1 and S-5 ask what a server PRESENTS during a handshake, and that
# question cannot be put to an address nobody listens on. The exception stops at
# this compose file - 172.28.0.0/16 is unreachable from anywhere else.

ok.test:53 {
    file /etc/coredns/ok.test.zone
    errors
}

# The only name here that answers on the wire. See the zone file for why.
partner.test:53 {
    file /etc/coredns/partner.test.zone
    errors
}

# The second name that answers, and it points at the MIDDLEBOX rather than at a
# server - S-1. Reserved by RFC 2606, so it belongs to nobody and the bench can
# answer for it without pretending to be somebody else's registry.
example.net:53 {
    file /etc/coredns/example.net.zone
    errors
}

# The third zone that answers on the wire, and the only one whose names differ
# from each other in nothing but what a PAC file says about them - P4c. The
# server they point at hands out that PAC file as well, so one address is both
# the subject of the question and the source of the rule.
proxy.test:53 {
    file /etc/coredns/proxy.test.zone
    errors
}

# A name whose resolver is broken rather than absent. Measured on this image:
# forwarding to an unroutable address produces SILENCE, not SERVFAIL, so the
# response code has to be stated outright - docs/17 section 6d.
servfail.test:53 {
    template ANY ANY {
        rcode SERVFAIL
    }
    errors
}

# A resolver that refuses to answer at all, which is a different fact again.
refused.test:53 {
    template ANY ANY {
        rcode REFUSED
    }
    errors
}

# Everything else is NXDOMAIN from here rather than a trip to the internet. This
# bench answers the same way with the network unplugged, which is the property
# that makes it usable as an oracle.
. {
    template ANY ANY {
        rcode NXDOMAIN
    }
    errors
}
